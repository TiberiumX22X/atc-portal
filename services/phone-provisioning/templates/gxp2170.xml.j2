<!-- Клавиши линий (multi_linekey), до 16 шт. P-коды взяты из реального
     шаблона Yeastar для GXP2170 (не расчётные) -->
{% set LINEKEY_P = [
  (2987,2988,2989,2990), (2991,2992,2993,2994), (2995,2996,2997,2998),
  (1369,1370,1471,1472), (1371,1372,1473,1474), (1373,1374,1475,1476),
  (23800,23801,23802,23803), (23804,23805,23806,23807), (23808,23809,23810,23811),
  (23812,23813,23814,23815), (23816,23817,23818,23819), (23820,23821,23822,23823),
  (23824,23825,23826,23827), (23828,23829,23830,23831), (23832,23833,23834,23835),
  (23836,23837,23838,23839)
] %}
{% for k in blf_keys[:16] %}
{% set p = LINEKEY_P[loop.index0] %}
<P{{ p[0] }}>{{ 'blf' if k.key_mode == 'BLF' else 'line' }}</P{{ p[0] }}>
<P{{ p[1] }}>1</P{{ p[1] }}>
<P{{ p[2] }}>{{ k.description }}</P{{ p[2] }}>
<P{{ p[3] }}>{{ k.value }}</P{{ p[3] }}>
{% endfor %}

<P2>{{ s.admin_password }}</P2>
<P6767>1</P6767>
<P192>{{ s.firmware_server }}</P192>
<P212>1</P212>
<P193>10080</P193>
<P194>1</P194>
<P238>0</P238>
<!-- Action URI (нужно для массовой перезагрузки телефонов через встроенный
     веб-API Grandstream) — P-номера подтверждены диффом реального конфига
     GRP2613, одинаковы на всех моделях. P32052 (Action URI Allowed IP List)
     зафиксирован как "any" — намеренно НЕ берётся из /admin/settings.
     На практике сужение до конкретного IP (VIP или физический адрес) дважды
     приводило к отказу массовой перезагрузки: сервер шлёт команду со своего
     ФИЗИЧЕСКОГО адреса (то freepbx1, то freepbx2 при HA), а не с VIP — телефон
     с более узким списком эти команды отклонял (401). -->
<P32050>1</P32050>
<P32051>0</P32051>
<P32052>any</P32052>
<P1549>1</P1549>
<P2918>{{ '1' if s.color_screensaver_enabled == '1' else '0' }}</P2918>
<!-- Яркость экрана: P334=активная, P335=в ожидании — вывод по совпадению
     значений в реальном конфиге (P335 менялось 60→100 ровно при установке 100%) -->
<P334>{{ s.color_brightness }}</P334>
<P335>{{ s.color_brightness }}</P335>
<!-- Bluetooth Power: подтверждено изолированным диффом (единственное изменение
     при переключении Bluetooth на самом телефоне) -->
<P2910>{{ '1' if s.color_bluetooth_enabled == '1' else '0' }}</P2910>
<P237>{{ s.config_server }}</P237>
<P1362>{{ s.language }}</P1362>
<P1650>1</P1650>
<P30>{{ s.ntp_server }}</P30>
<P64>{{ s.timezone }}</P64>
<P102>{{ s.date_format }}</P102>
<P122>{{ s.time_format }}</P122>
</config>
</gs_provision>
