<P270>{{ device.label }}</P270>
<P47>{{ s.sip_server if ':' in s.sip_server else s.sip_server ~ ':' ~ s.sip_port }}</P47>
<P35>{{ device.extension }}</P35>
<P36>{{ device.extension }}</P36>
<P34>{{ device.sip_password }}</P34>
