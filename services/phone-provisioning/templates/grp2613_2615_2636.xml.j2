<?xml version="1.0" encoding="UTF-8" ?>
<gs_provision version="1">
<mac>{{ mac }}</mac>
<config version="1">
<!-- ПЕРЕВЕДЕНО НА P-VALUE 11.08.2026: item/part формат стабильно вызывал
     "Failed to authenticate" на SIP-регистрации у GRP2615 (проверено пошагово:
     конфиг доставляется корректно 200 OK, username/realm верные на проводе,
     пароль совпадает во всех источниках — но digest всё равно не проходит).
     Экспорт конфига с самого живого GRP2615 (P3=7001, P35=7001, P36=7001,
     P2910/P334/P335/P2918 с теми же значениями, что мы настраивали) подтвердил:
     внутреннее представление настроек у GRP-линейки — то же самое P-value,
     что и у GXP2170, номера полей совпадают. P-value шаблон для GXP2170 уже
     подтверждён рабочим (успешная регистрация), поэтому здесь используется
     ровно та же нумерация вместо item/part. -->
<P91>1</P91>
<P330>2</P330>
{% if s.phonebook_url %}<P331>{{ s.phonebook_url }}</P331>{% endif %}
<P333>0</P333>

<!-- Аккаунт 1 (основной) -->
<P271>{{ '1' if device.active else '0' }}</P271>
<P270>{{ device.label }}</P270>
<P47>{{ s.sip_server if ':' in s.sip_server else s.sip_server ~ ':' ~ s.sip_port }}</P47>
<P35>{{ device.extension }}</P35>
<P36>{{ device.extension }}</P36>
<P34>{{ device.sip_password }}</P34>
<P3>{{ device.label }}</P3>
<P31>1</P31>
<P191>0</P191>
<P130>0</P130>
<P90>0</P90>
<!-- Auto Answer по Call-Info (не путать с P90 — тот включил бы безусловный
     автоответ на ЛЮБОЙ звонок). P298/P2356 (и P438/P2456 для линии 2)
     требуют звонок с заголовком Call-Info: answer-after=0.
     ВАЖНО: пустое значение этого поля НЕ является надёжной альтернативой —
     проверено, что уже применённое (пустое или заполненное) значение
     не всегда перезаписывается новым провижинингом на этой прошивке
     (пустой тег трактуется как "не менять поле", а не "очистить"). Поэтому
     здесь намеренно зафиксировано одно и то же непустое значение для ВСЕГО
     парка — так все телефоны (и новые, и уже тронутые руками при отладке)
     сходятся к одному состоянию. Работоспособность зависит от того, что
     Asterisk/панель оповещения реально ставит такой же заголовок Call-Info
     на INVITE к телефону (см. заметки проекта про AMI Originate/Variable) —
     без этого автоответ работать не будет, даже с верным значением здесь. -->
<P298>1</P298>
<P2356>answer-after=0</P2356>
<P57>0</P57><P58>8</P58><P59>18</P59><P60>2</P60><P61>9</P61><P62>98</P62><P46>4</P46>
<P72>#</P72>

<!-- Аккаунт 2 (линия 2, опционально) -->
{% if device.extension2 %}
<P401>{{ '1' if device.active2 else '0' }}</P401>
<P417>{{ device.label2 or device.extension2 }}</P417>
<P402>{{ s.sip_server if ':' in s.sip_server else s.sip_server ~ ':' ~ s.sip_port }}</P402>
<P404>{{ device.extension2 }}</P404>
<P405>{{ device.extension2 }}</P405>
<P406>{{ device.sip_password2 }}</P406>
<P407>{{ device.label2 or device.extension2 }}</P407>
<P410>1</P410>
<P420>0</P420>
<P448>0</P448>
<P425>0</P425>
<P438>1</P438>
<P2456>answer-after=0</P2456>
<P451>0</P451><P452>8</P452><P453>18</P453><P454>2</P454><P455>9</P455><P456>98</P456><P457>4</P457>
<P492>#</P492>
{% else %}
<P401>0</P401>
{% endif %}

<!-- Аккаунты 3-6: не используются, оставлены выключенными -->
<P501>0</P501>
<P601>0</P601>
<P1701>0</P1701>
<P1801>0</P1801>
<P538>0</P538>
<P638>0</P638>
<P1738>0</P1738>
<P1838>0</P1838>

<P2>{{ s.admin_password }}</P2>
<P6767>1</P6767>
<P192>{{ s.firmware_server }}{{ '/' + firmware_file if firmware_file else '' }}</P192>
<P212>1</P212>
<P193>10080</P193>
<P194>1</P194>
<P238>0</P238>
<!-- Action URI (нужно для массовой перезагрузки телефонов через встроенный
     веб-API Grandstream) — P-номера подтверждены диффом реального конфига
     GRP2613, одинаковы на всех моделях. P32052 (Action URI Allowed IP List)
     зафиксирован как "any" — намеренно НЕ берётся из /admin/settings.
     На практике сужение до конкретного IP (VIP или физический адрес) дважды
     приводило к отказу массовой перезагрузки: сервер шлёт команду со своего
     ФИЗИЧЕСКОГО адреса (то freepbx1, то freepbx2 при HA), а не с VIP — телефон
     с более узким списком эти команды отклонял (401). -->
<P32050>1</P32050>
<P32051>0</P32051>
<P32052>any</P32052>
<P1549>1</P1549>
<P2918>{{ '1' if s.color_screensaver_enabled == '1' else '0' }}</P2918>
<P334>{{ s.color_brightness }}</P334>
<P335>{{ s.color_brightness }}</P335>
<P2910>{{ '1' if s.color_bluetooth_enabled == '1' else '0' }}</P2910>
<!-- Wi-Fi (color_wifi_enabled) — P-номер для GRP2615/2636 пока не найден
     (был доступен только через item/part "network.wifi.enable"). Оставлено
     без переноса до подтверждения реальным диффом конфига с живого
     устройства — переключатель в интерфейсе временно не действует на
     P-value шаблоне. -->
<P237>{{ s.config_server }}</P237>
<P1362>{{ s.language }}</P1362>
<P1650>1</P1650>
<P30>{{ s.ntp_server }}</P30>
<P64>{{ s.timezone }}</P64>
<P102>{{ s.date_format }}</P102>
<P122>{{ s.time_format }}</P122>
</config>
</gs_provision>
