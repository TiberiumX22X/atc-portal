# Виртуальные окружения Python (создаются install.sh на каждом сервисе)
**/venv/
__pycache__/
*.pyc

# Секреты и сгенерированные при установке файлы — НИКОГДА не должны
# попасть в репозиторий: пароли, ключи подписи сессии, AMI-секреты
**/.env
**/.secret_key
**/.flash_secret
**/INITIAL_PASSWORD.txt
**/.cdrpanel_mysql_password
**/*.before-restore

# Базы данных — создаются заново при установке, содержат реальные данные
# пользователей/конференций/устройств конкретного сервера
**/*.db
**/*.db-journal
**/*.db-wal
**/*.db-shm

# Записи звонков и звуки оповещений — не часть кода проекта
**/recordings/

# Резервные копии, которые кто-то мог сохранить рядом при тестировании
*.tar.gz
atc-portal-backup-*.tar.gz

# Стандартный мусор редакторов/ОС
.DS_Store
*.swp
.idea/
.vscode/
